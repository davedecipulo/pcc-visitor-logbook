# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Secret key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY: never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
